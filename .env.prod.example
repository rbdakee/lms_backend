# Образец боевого окружения. На сервере копируется в `.env` рядом
# с docker-compose.prod.yml и заполняется настоящими значениями.
#
# Ключей и паролей в репозитории нет и не появляется: `.env` под gitignore,
# здесь — только заглушки.

ENV=prod

# --- Домены -----------------------------------------------------------
# Домен API: на него выпускается сертификат, он же должен указывать
# на этот сервер A-записью до первого запуска
API_DOMAIN=api.domain.kz
# Адрес для писем Let's Encrypt об истекающих сертификатах
ACME_EMAIL=admin@domain.kz

# --- База -------------------------------------------------------------
POSTGRES_USER=lms
POSTGRES_PASSWORD=ЗАМЕНИТЬ-длинный-случайный-пароль
POSTGRES_DB=lms
# Хост — имя сервиса в compose, а не localhost
DATABASE_URL=postgresql+psycopg://lms:ЗАМЕНИТЬ-длинный-случайный-пароль@db:5432/lms

# --- Два фронта -------------------------------------------------------
CORS_ORIGINS=["https://domain.kz","https://admin.domain.kz"]
# Кука на родительский домен покрывает оба приложения
COOKIE_DOMAIN=.domain.kz
COOKIE_SECURE=true

# Адрес клиента берётся из X-Real-IP, который ставит Caddy. Включать только
# там, где до сервиса нет дороги мимо прокси: в docker-compose.prod.yml порт
# сервиса наружу не публикуется — если это изменить, значение нужно вернуть
# в false, иначе потолки SMS и проверки сертификата обходятся заголовком.
TRUST_REAL_IP=true

# --- Адреса, которые уходят людям -------------------------------------
# Откуда фронт скачивает файл
PUBLIC_BASE_URL=https://api.domain.kz
# Куда ведёт QR с бумажного сертификата: клиентское приложение, НЕ API
VERIFY_BASE_URL=https://domain.kz
# Куда ведёт кнопка «Открыть в админке» в уведомлениях бота: третий деплой
ADMIN_BASE_URL=https://admin.domain.kz

# --- Хранилище файлов -------------------------------------------------
STORAGE_PROVIDER=s3
# Адрес площадки, а не адрес бакета: имя бакета boto3 подставит сам
S3_ENDPOINT_URL=https://object.pscloud.io
S3_BUCKET=lms-main
S3_ACCESS_KEY=ЗАМЕНИТЬ
S3_SECRET_KEY=ЗАМЕНИТЬ
# Секрет подписи ссылок на файлы. Смена секрета гасит все выданные ссылки —
# это не страшно, фронт перевыдаёт их молча
STORAGE_SECRET=ЗАМЕНИТЬ-длинная-случайная-строка

# --- SMS --------------------------------------------------------------
# Настоящего адаптера нет: код входа печатается в лог сервиса и SMS
# не уходит никому. Пока это так, учитель войти не может — см. DEPLOY.md
SMS_PROVIDER=log

# --- Вход первого админа без SMS --------------------------------------
# Пока настоящего SMS-провайдера нет, один номер входит фиксированным кодом
# и он же заводится админом при старте. Это бэкдор; снимается снятием обеих
# строк, без релиза. Появится SMS — снять.
AUTH_BOOTSTRAP_PHONE=+7XXXXXXXXXX
AUTH_BOOTSTRAP_CODE=XXXX

# --- Telegram ---------------------------------------------------------
TELEGRAM_PROVIDER=bot
TELEGRAM_BOT_TOKEN=ЗАМЕНИТЬ
TELEGRAM_BOT_USERNAME=ЗАМЕНИТЬ
TELEGRAM_WEBHOOK_SECRET=ЗАМЕНИТЬ-длинная-случайная-строка
# В бою всегда webhook: poll ломает вебхук, если его не убрали
TELEGRAM_UPDATES=webhook
