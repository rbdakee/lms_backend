# Скопировать в .env и поправить под своё окружение. Значения по умолчанию
# подходят для локальной разработки с docker compose — файл можно не создавать.

ENV=dev
DATABASE_URL=postgresql+psycopg://lms:lms@localhost:5445/lms

# Через запятую. В бою — https://domain.kz,https://admin.domain.kz
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Какие из них — админка. Имя куки сессии зависит от приложения, и только так
# админ и учитель живут в одном браузере одновременно. Умолчания у настройки
# нет: пусто — кука общая, как было до разделения, и в логе предупреждение.
# Источник обязан быть и в CORS_ORIGINS, иначе браузер до API не дойдёт.
ADMIN_ORIGINS=["http://localhost:3001"]

# В бою — .domain.kz: имена кук у приложений разные, общий домен им не мешает.
# Пусто = текущий хост.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Адрес клиента для лимитов: суточный потолок SMS и потолок публичной
# проверки сертификата. Читается X-Real-IP, который прокси переписывает
# целиком; X-Forwarded-For не читается вовсе — его первый элемент клиент
# приписывает себе сам. Локально прокси нет, и заголовку верить нельзя.
# В бою — true, см. DEPLOY.md, «Адрес клиента».
TRUST_REAL_IP=false

# Чем доставляется код входа. `log` — заглушка: пишет код в лог сервиса,
# это версия для разработки. `whatsapp` — бой: код уходит согласованным
# шаблоном через Cloud API, и четыре строки ниже тогда обязательны.
# Любое другое значение сервис не поднимет — так же, как неизвестные
# STORAGE_PROVIDER и TELEGRAM_PROVIDER.
SMS_PROVIDER=log
# Номер отправителя и постоянный токен системного пользователя — из Meta
# Business Manager. Пустые при SMS_PROVIDER=whatsapp роняют сервис при старте.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Имя и язык согласованного шаблона, как они заведены в Meta. Шаблон должен
# быть категории Authentication: свободный текст WhatsApp принимает только
# внутри 24-часового окна, а на входе его нет никогда.
WHATSAPP_TEMPLATE_NAME=otp_ru
WHATSAPP_TEMPLATE_LANGUAGE=ru
# Шаблон Authentication по умолчанию идёт с кнопкой «Скопировать код»,
# и тогда код передаётся дважды — в теле и в кнопке. Шаблон без кнопки
# лишнего параметра не примет.
WHATSAPP_TEMPLATE_HAS_BUTTON=true

# Приватное хранилище файлов. `local` — каталог на диске, он создаётся сам
# и в git не уходит. `s3` — бакет объектного хранилища, это бой: четыре
# строки ниже тогда обязательны, пустые сервис не поднимет.
STORAGE_PROVIDER=local
STORAGE_DIR=var/storage
# Адрес площадки, а не адрес бакета: имя бакета boto3 подставит сам.
# У PS Cloud это https://object.pscloud.io
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Секрет подписи ссылок на файлы: по ней сервис отдаёт байты и по ней же
# проверяет право на них. В бою — длинная случайная строка.
STORAGE_SECRET=dev-secret
# Адрес, с которого фронт скачивает файл. В бою — https://api.domain.kz
PUBLIC_BASE_URL=http://localhost:8000
# Куда ведёт QR с бумажного сертификата: адрес КЛИЕНТСКОГО приложения,
# где живёт страница /verify. В бою — https://domain.kz, а не адрес API.
# Пусто — QR на сертификате не печатается.
VERIFY_BASE_URL=http://localhost:3000
# Куда ведёт кнопка «Открыть в админке» в уведомлениях бота. В бою —
# https://admin.domain.kz: админка — свой, третий деплой, не API.
# 127.0.0.1, а не localhost — на этом хосте Bot API отказывает кнопке
# (и всему сообщению целиком), а по IP тот же адрес принимает.
ADMIN_BASE_URL=http://127.0.0.1:3001

# Telegram-бот админа. Заглушка `log` пишет уведомления в лог и никуда не ходит;
# `bot` — настоящая отправка. Токен и имя бота выдаёт @BotFather.
TELEGRAM_PROVIDER=log
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Секрет вебхука — то же значение, что уходит в setWebhook параметром
# secret_token: только он отличает запрос Telegram от чужого. Пусто —
# вебхук отвергает всё.
TELEGRAM_WEBHOOK_SECRET=
# Как получать апдейты. `webhook` — прод, домен и так публичный. `poll` —
# только локальная разработка без туннеля наружу: сервис сам вытягивает
# апдейты через getUpdates (см. DEPLOY.md, «Telegram-вебхук»).
TELEGRAM_UPDATES=webhook

# Первый админ на чистой базе: номер заводится админом при старте. Прод
# поднимается пустым, и без этого некому выдать первый доступ и завести курс.
# Номер — казахстанский, в любом виде: нормализуется как обычный.
AUTH_BOOTSTRAP_PHONE=
# Необязательная вторая половина: с ней тот же номер входит фиксированным
# кодом, минуя провайдера. Это бэкдор, и нужен он там, где кода взять
# неоткуда. С работающим WhatsApp оставлять его незачем — пустое выключает.
# Ровно столько цифр, сколько в CODE_LENGTH, иначе сервис не поднимется.
AUTH_BOOTSTRAP_CODE=
