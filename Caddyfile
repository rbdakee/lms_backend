# Прокси перед сервисом. Сертификаты Caddy выпускает и продлевает сам —
# отдельного шага в деплое под это нет, нужен только домен, который
# указывает на этот сервер, и открытые 80 и 443.
{
	# Адрес для писем Let's Encrypt об истекающих сертификатах
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	reverse_proxy api:8000 {
		# Адрес клиента для лимитов. Заголовок ставится ЦЕЛИКОМ, а не
		# дописывается: `header_up` без префикса заменяет присланное
		# клиентом. Сервис читает именно его и не читает X-Forwarded-For
		# (DEPLOY.md, «Адрес клиента»).
		header_up X-Real-IP {remote_host}
	}

	# Не меньше UPLOAD_MAX_MB, иначе сдача работы упирается в прокси
	# и человек видит обрыв вместо понятного отказа сервиса
	request_body {
		max_size 20MB
	}

	# Логи — в stdout, забирает docker; формат тот же, что у сервиса
	log {
		output stdout
	}
}
